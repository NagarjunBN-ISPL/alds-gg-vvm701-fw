# Console: move from UART0 to USB Serial JTAG so UART0 is free for Nuvoton MS51
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART is not set

# Flash size: VVM701 has 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_AFTER_RESET=y

# Task WDT: 120 s timeout, auto-init, no panic (log only)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=120
# CONFIG_ESP_TASK_WDT_PANIC is not set

# Dynamic Frequency Scaling: 160 MHz idle → 240 MHz active
CONFIG_PM_ENABLE=y

# Partition table: custom dual-OTA layout
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Stack overflow detection (canary)
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Heap integrity checking (light — production safe)
CONFIG_HEAP_CORRUPTION_DETECTION_LIGHT=y
