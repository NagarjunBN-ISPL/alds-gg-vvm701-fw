# ── Build output ─────────────────────────────────────────────────────────
# PlatformIO is the single canonical build path (see platformio.ini).
.pio/
# Native ESP-IDF (idf.py) output — the project does NOT use this path; it is
# ignored so an accidental `idf.py build` can't commit a second, divergent
# set of binaries.
build/

# ── Tool-generated sdkconfig ─────────────────────────────────────────────
# sdkconfig.defaults is the single tracked source of truth. Each toolchain
# regenerates its own concrete sdkconfig locally from it, so the generated
# variants stay out of git to stop one toolchain's config drifting against
# or overwriting the other's.
sdkconfig
sdkconfig.old
sdkconfig.esp32-s3-devkitc-1

# ── Editor / tooling (local, not shared) ─────────────────────────────────
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.clangd
.cache/
.claude/

# ── Scratch / generated artifacts (not source) ───────────────────────────
ALL_SOURCE_FOR_REVIEW.txt

# ── OS cruft ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
